{
  // Tests run on Node (not React Native), so they get Node's types; the app
  // code keeps its own tsconfig without them.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["../node_modules"]
}
